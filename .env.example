# Ghar Ka Pandit - Environment Configuration Example

# Canonical Domain URL (used for sitemap, canonical links, and Open Graph metadata)
NEXT_PUBLIC_SITE_URL=https://gharkapandit-bangalore.com

# Business WhatsApp Number (format: country code + 10 digits without + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=919000000000

# Business Phone Number
NEXT_PUBLIC_PHONE_NUMBER=+91 90000 00000

# Support Email
NEXT_PUBLIC_EMAIL=bookings@example.com
